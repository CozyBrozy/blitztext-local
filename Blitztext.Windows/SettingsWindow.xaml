<Window x:Class="Blitztext.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Blitztext Lokal" Width="600" Height="640" MinWidth="460" MinHeight="440" Icon="Assets/Blitztext.ico" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="24">
  <TextBlock Text="Blitztext Lokal" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <Button Content="Gesprächsmodus öffnen" Click="Conversation_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
  <TextBlock x:Name="ModelStatusText" Visibility="Collapsed" Foreground="#9E233B" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <Border Style="{StaticResource Card}" Margin="0,16,0,12">
   <StackPanel>
    <DockPanel Margin="0,0,0,10">
     <Button DockPanel.Dock="Right" Content="Mikrofone neu laden" Click="Reload_Click" Style="{StaticResource Action}" Padding="8,3" MinHeight="28" FontSize="12"/>
     <TextBlock Text="Audiogeräte" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="Mikrofon" Margin="0,0,0,4"/>
    <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Index" MinHeight="30" AutomationProperties.Name="Mikrofon"/>
    <TextBlock Text="Computerton" Margin="0,10,0,4"/>
    <ComboBox x:Name="OutputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="30" AutomationProperties.Name="Computerton"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <TextBlock Text="Diktat und Sprache" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="Sprache (de, en oder auto)" Margin="0,0,0,4"/>
    <TextBox x:Name="LanguageBox" Padding="8,5" AutomationProperties.Name="Sprache"/>
    <TextBlock Text="Tastenkombination" Margin="0,10,0,4"/>
    <TextBox x:Name="HotkeyBox" Padding="8,5" AutomationProperties.Name="Tastenkombination"/>
    <ComboBox x:Name="ModeBox" MinHeight="30" Margin="0,8,0,0" AutomationProperties.Name="Aufnahmemodus">
     <ComboBoxItem Content="Einmal drücken zum Starten, erneut zum Stoppen"/>
     <ComboBoxItem Content="Gedrückt halten zum Aufnehmen"/>
    </ComboBox>
    <CheckBox x:Name="AutoPasteBox" Content="Text automatisch in die aktive App einfügen" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
  <Button Content="Speichern" Click="Save_Click" Style="{StaticResource Action}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>
