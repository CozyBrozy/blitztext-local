<Window x:Class="Blitztext.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Blitztext Lokal" Width="600" Height="620" MinWidth="480" MinHeight="500"
 WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="28">
 <TextBlock Text="Blitztext Lokal" FontSize="28" FontWeight="SemiBold"/>
 <TextBlock Text="Diktieren auf diesem PC. Ohne API-Key und ohne Cloud." TextWrapping="Wrap" Margin="0,8,0,20"/>
 <Border Background="White" Padding="16" CornerRadius="8">
 <StackPanel>
 <TextBlock Text="Whisper Small, mehrsprachig" FontWeight="SemiBold"/>
 <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap" Margin="0,8,0,0"/>
 <TextBlock Text="Audio wird lokal verarbeitet. Temporäre Aufnahmen werden nach der Verarbeitung gelöscht. Text verbessern ist in dieser Version deaktiviert." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#526071"/>
 </StackPanel>
 </Border>
 <TextBlock Text="Mikrofon" FontWeight="SemiBold" Margin="0,20,0,6"/>
 <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Index" MinHeight="32"/>
 <Button Content="Mikrofone neu laden" Click="Reload_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,12"/>
 <TextBlock Text="Computerton im Gesprächsmodus" FontWeight="SemiBold" Margin="0,8,0,6"/>
 <ComboBox x:Name="OutputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="32"/>
 <Button Content="Gesprächsmodus öffnen" Click="Conversation_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,10,0,14"/>
 <TextBlock Text="Sprache (de, en oder auto)" Margin="0,0,0,6"/>
 <TextBox x:Name="LanguageBox" Padding="8,5"/>
 <TextBlock Text="Tastenkombination" Margin="0,12,0,6"/>
 <TextBox x:Name="HotkeyBox" Padding="8,5"/>
 <TextBlock Text="Beispiel: Ctrl+Shift+Space" Foreground="#526071" Margin="0,4,0,8"/>
 <ComboBox x:Name="ModeBox" MinHeight="32">
 <ComboBoxItem Content="Einmal drücken zum Starten, erneut zum Stoppen"/>
 <ComboBoxItem Content="Gedrückt halten zum Aufnehmen"/>
 </ComboBox>
 <CheckBox x:Name="AutoPasteBox" Content="Text automatisch in die aktive App einfügen" Margin="0,14,0,14"/>
 <Button Content="Speichern" Click="Save_Click" Padding="16,8" HorizontalAlignment="Right"/>
 <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>
