<Window x:Class="Blitztext.Windows.ConversationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Blitztext Lokal: Gespräch" Width="850" Height="650" MinWidth="600" MinHeight="450"
 WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="24">
 <StackPanel DockPanel.Dock="Top">
 <TextBlock Text="Gespräch aufnehmen" FontSize="26" FontWeight="SemiBold"/>
 <TextBlock Text="Live-Transkript mit Zeitstempeln. Du = Mikrofon. Andere Teilnehmer = Computerton. Alles lokal." TextWrapping="Wrap" Margin="0,8,0,10"/>
 <TextBlock x:Name="DevicesText" TextWrapping="Wrap" Foreground="#526071"/>
 <WrapPanel Margin="0,14,0,12">
 <Button x:Name="RecordButton" Content="Gespräch starten" Click="Record_Click" Padding="16,8" Margin="0,0,12,0"/>
 <Button Content="Transkript kopieren" Click="Copy_Click" Padding="16,8" Margin="0,0,12,0"/>
 <Button Content="Ablage öffnen" Click="Folder_Click" Padding="16,8"/>
 </WrapPanel>
 <TextBlock x:Name="StatusText" Text="Bereit. Es wird noch nicht aufgenommen." TextWrapping="Wrap" Margin="0,0,0,12"/>
 </StackPanel>
 <TextBlock DockPanel.Dock="Bottom" x:Name="SavedText" TextWrapping="Wrap" Foreground="#526071" Margin="0,10,0,0"/>
 <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
 VerticalScrollBarVisibility="Auto" Padding="14" FontFamily="Consolas"/>
 </DockPanel>
</Window>
