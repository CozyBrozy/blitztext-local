<Window x:Class="Blitztext.Windows.ConversationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Blitztext Lokal: Gespräch" Width="850" Height="650" MinWidth="540" MinHeight="425" Icon="Assets/Blitztext.ico" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Gespräch aufnehmen" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock x:Name="DevicesText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
   <WrapPanel Margin="0,12,0,8">
    <Button x:Name="RecordButton" Content="Gespräch starten" Click="Record_Click" Style="{StaticResource Primary}" Margin="0,0,8,4"/>
    <Button Content="Transkript kopieren" Click="Copy_Click" Style="{StaticResource Action}" Margin="0,0,8,4"/>
    <Button Content="Ablage öffnen" Click="Folder_Click" Style="{StaticResource Action}" Margin="0,0,0,4"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" Text="Bereit" TextWrapping="Wrap" Margin="0,0,0,10"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock Text="Transkriptname" Margin="0,0,0,4"/>
   <DockPanel Margin="0,0,0,8">
    <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="Namen speichern" Click="Rename_Click" Style="{StaticResource Action}" IsEnabled="False" Margin="8,0,0,0"/>
    <TextBox x:Name="TranscriptTitleBox" MaxLength="120" Padding="8,6" VerticalContentAlignment="Center"
     AutomationProperties.Name="Transkriptname" ToolTip="Nach dem Stoppen einen Namen speichern. Gleiche Namen erhalten einen freien Zusatz."/>
   </DockPanel>
   <TextBlock x:Name="SavedText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
   <TextBlock x:Name="TranscriptLinks" Visibility="Collapsed" TextWrapping="Wrap">
    <Hyperlink Click="OpenTranscript_Click" Foreground="#5635B2"><Run x:Name="TranscriptName"/></Hyperlink>
    <Run Text="   ·   "/><Hyperlink Click="RevealTranscript_Click" Foreground="#5635B2">Im Explorer anzeigen</Hyperlink>
   </TextBlock>
  </StackPanel>
  <Border Style="{StaticResource Card}" Padding="4">
   <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Gesprächstranskript"
    VerticalScrollBarVisibility="Auto" Padding="12" BorderThickness="0" Background="Transparent" FontSize="15"/>
  </Border>
 </DockPanel>
</Window>
