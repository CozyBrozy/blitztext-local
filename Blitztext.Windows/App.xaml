<Application x:Class="Blitztext.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
<SolidColorBrush x:Key="Ink" Color="#202035"/>
<SolidColorBrush x:Key="Muted" Color="#5C6076"/>
<SolidColorBrush x:Key="Canvas" Color="#F5F4FA"/>
<Style x:Key="Card" TargetType="Border">
 <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E1EF"/>
 <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
 <Setter Property="Padding" Value="16"/>
</Style>
<Style x:Key="Action" TargetType="Button">
 <Setter Property="Foreground" Value="#4B3C85"/><Setter Property="Background" Value="#EEEBF7"/>
 <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="34"/>
 <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
 <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
 </Border>
 <ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#A593D7"/></Trigger>
 <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="#9B82E9"/></Trigger>
 <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Opacity" Value=".8"/></Trigger>
 <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value=".45"/></Trigger>
 </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
 <Setter Property="Background" Value="#6141C1"/><Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="42"/>
</Style>
 </Application.Resources>
</Application>
